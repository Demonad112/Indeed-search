# Copy to .env and fill in. .env is gitignored.

# REQUIRED. Goes into the User-Agent on every outbound request so employers /
# ATS operators can identify and contact you. discover.py refuses to run without it.
JOBPIPE_CONTACT_EMAIL=Addy72@hotmail.com

# Where the SQLite database lives.
JOBPIPE_DB=data/jobpipe.db

# Politeness. Minimum seconds between requests to any single host, plus a random
# 0..JOBPIPE_JITTER extra. Constraint #4 says 2s minimum — going lower is on you.
JOBPIPE_MIN_INTERVAL=2.0
JOBPIPE_JITTER=0.75

# HTTP timeout (seconds) and retry count for transient 429/5xx.
JOBPIPE_HTTP_TIMEOUT=30
JOBPIPE_HTTP_RETRIES=3

# REQUIRED for Phase 2 (score). `python run.py score` refuses to start without it.
# ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED for Phase 4 (the dashboard). It will not start without one.
# Any passphrase works; this just stops a stray tunnel exposing your resume.
JOBPIPE_PASSPHRASE=change-me-to-something-only-you-know

# Recorded as `approved_by` on every approval, for the audit trail.
JOBPIPE_APPROVER=addison
